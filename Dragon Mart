<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DRAGON MART | Wear Your Style. Own Your Identity.</title>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ==========================================
           DRAGON MART - MASTER STYLESHEET
           ========================================== */
        :root {
            --bg-black: #0a0a0a;
            --card-black: #141414;
            --border-gray: #262626;
            --primary-red: #e60000;
            --primary-red-hover: #ff1a1a;
            --text-white: #ffffff;
            --text-gray: #a3a3a3;
            --font-heading: 'Cinzel', serif;
            --font-body: 'Poppins', sans-serif;
            --transition: all 0.3s ease;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background-color: var(--bg-black); color: var(--text-white); font-family: var(--font-body); line-height: 1.6; overflow-x: hidden; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

        .announcement-bar { background-color: var(--primary-red); color: var(--text-white); text-align: center; padding: 8px 10px; font-size: 0.85rem; font-weight: 500; }
        .header { background-color: rgba(10, 10, 10, 0.95); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid var(--border-gray); }
        .navbar { display: flex; justify-content: space-between; align-items: center; height: 80px; }
        .logo { font-family: var(--font-heading); font-size: 1.8rem; font-weight: 900; letter-spacing: 2px; display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .logo i { color: var(--primary-red); }
        .logo span { color: var(--primary-red); }
        .nav-menu { display: flex; gap: 30px; align-items: center; }
        .nav-menu a { font-size: 0.95rem; font-weight: 500; color: var(--text-gray); transition: var(--transition); cursor: pointer; }
        .nav-menu a:hover, .nav-menu a.active { color: var(--primary-red-hover); }
        .admin-link { color: var(--primary-red) !important; border: 1px solid var(--primary-red); padding: 5px 12px; border-radius: 4px; }
        .nav-icons { display: flex; align-items: center; gap: 20px; }
        .cart-icon-btn { position: relative; font-size: 1.3rem; color: var(--text-white); cursor: pointer; }
        .cart-icon-btn .badge { position: absolute; top: -8px; right: -10px; background-color: var(--primary-red); color: var(--text-white); font-size: 0.7rem; padding: 2px 6px; border-radius: 50%; font-weight: 600; }

        /* Hero */
        .hero { position: relative; height: 85vh; background: url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat; display: flex; align-items: center; }
        .hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.7) 100%); }
        .hero-content { position: relative; z-index: 2; max-width: 650px; }
        .sub-heading { color: var(--primary-red); font-weight: 600; letter-spacing: 2px; font-size: 0.9rem; text-transform: uppercase; display: block; margin-bottom: 15px; }
        .hero-content h1 { font-family: var(--font-heading); font-size: 3.2rem; line-height: 1.2; margin-bottom: 20px; }
        .hero-content h1 span { color: var(--primary-red); }
        .hero-content p { color: var(--text-gray); font-size: 1.05rem; margin-bottom: 30px; }
        .hero-btns { display: flex; gap: 15px; }

        /* Buttons */
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 12px 28px; font-weight: 600; font-size: 0.95rem; border-radius: 4px; cursor: pointer; transition: var(--transition); border: none; }
        .btn-primary { background-color: var(--primary-red); color: var(--text-white); }
        .btn-primary:hover { background-color: var(--primary-red-hover); box-shadow: 0 0 15px rgba(230, 0, 0, 0.4); }
        .btn-outline { background: transparent; color: var(--text-white); border: 1px solid var(--text-white); }
        .btn-outline:hover { border-color: var(--primary-red); color: var(--primary-red); }
        .btn-block { width: 100%; }

        /* Features Bar */
        .features-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding: 40px 20px; border-bottom: 1px solid var(--border-gray); max-width: 1200px; margin: 0 auto; }
        .feature-box { display: flex; align-items: center; gap: 15px; background: var(--card-black); padding: 20px; border-radius: 6px; border: 1px solid var(--border-gray); }
        .feature-box i { font-size: 2rem; color: var(--primary-red); }
        .feature-box h4 { font-size: 0.95rem; font-weight: 600; }
        .feature-box p { font-size: 0.8rem; color: var(--text-gray); }

        .section { padding: 80px 0; }
        .bg-darker { background-color: #050505; }
        .section-title { text-align: center; margin-bottom: 50px; }
        .section-title h2 { font-family: var(--font-heading); font-size: 2.3rem; margin-bottom: 10px; }
        .section-title h2 span { color: var(--primary-red); }
        .section-title p { color: var(--text-gray); font-size: 0.95rem; }

        /* Categories Grid */
        .categories-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .cat-card { position: relative; height: 280px; border-radius: 8px; overflow: hidden; border: 1px solid var(--border-gray); cursor: pointer; }
        .cat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .cat-card:hover img { transform: scale(1.08); }
        .cat-overlay { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(10,10,10,0.9) 0%, rgba(10,10,10,0.2) 100%); display: flex; align-items: flex-end; padding: 25px; }
        .cat-overlay h3 { font-size: 1.3rem; font-family: var(--font-heading); color: var(--text-white); }

        /* Products Grid */
        .products-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; }
        .product-card { background-color: var(--card-black); border: 1px solid var(--border-gray); border-radius: 8px; overflow: hidden; transition: var(--transition); display: flex; flex-direction: column; }
        .product-card:hover { transform: translateY(-5px); border-color: var(--primary-red); box-shadow: 0 10px 25px rgba(230, 0, 0, 0.15); }
        .product-img-box { position: relative; height: 260px; overflow: hidden; background-color: #1a1a1a; }
        .product-img-box img { width: 100%; height: 100%; object-fit: cover; transition: var(--transition); }
        .product-card:hover .product-img-box img { transform: scale(1.05); }
        .product-badge { position: absolute; top: 10px; left: 10px; background-color: var(--primary-red); color: var(--text-white); font-size: 0.7rem; padding: 3px 8px; border-radius: 3px; font-weight: 600; }
        .product-details { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
        .product-category { font-size: 0.75rem; color: var(--text-gray); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
        .product-title { font-size: 1rem; font-weight: 600; margin-bottom: 10px; height: 2.4rem; overflow: hidden; }
        .product-prices { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; }
        .current-price { font-size: 1.1rem; font-weight: 700; color: var(--primary-red); }
        .old-price { font-size: 0.9rem; color: var(--text-gray); text-decoration: line-through; }
        .product-actions { display: flex; gap: 10px; margin-top: auto; }
        .btn-cart, .btn-buy { flex: 1; padding: 10px; border-radius: 4px; font-weight: 600; cursor: pointer; transition: var(--transition); }
        .btn-cart { background: transparent; color: var(--text-white); border: 1px solid var(--border-gray); }
        .btn-cart:hover { background: var(--primary-red); border-color: var(--primary-red); }
        .btn-buy { background: var(--primary-red); color: var(--text-white); border: none; }
        .btn-buy:hover { background: var(--primary-red-hover); }

        /* Promo Banner */
        .promo-banner { background: linear-gradient(rgba(10,10,10,0.85), rgba(10,10,10,0.85)), url('https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat; padding: 100px 0; text-align: center; border-top: 1px solid var(--border-gray); border-bottom: 1px solid var(--border-gray); }
        .badge-tag { background-color: var(--primary-red); padding: 5px 12px; font-size: 0.8rem; font-weight: 600; border-radius: 3px; display: inline-block; margin-bottom: 15px; }
        .promo-inner h2 { font-family: var(--font-heading); font-size: 2.8rem; margin-bottom: 15px; }
        .promo-inner p { color: var(--text-gray); font-size: 1.1rem; max-width: 700px; margin: 0 auto 30px auto; }
        .highlight { color: var(--primary-red); font-weight: 700; }

        /* Shop Layout */
        .shop-layout { display: grid; grid-template-columns: 280px 1fr; gap: 30px; }
        .shop-sidebar { background: var(--card-black); border: 1px solid var(--border-gray); padding: 25px; border-radius: 8px; height: fit-content; }
        .filter-group { margin-bottom: 25px; }
        .filter-group h3 { font-family: var(--font-heading); font-size: 1rem; margin-bottom: 15px; border-bottom: 1px solid var(--border-gray); padding-bottom: 8px; }
        .search-box-input { position: relative; }
        .search-box-input input { width: 100%; background: var(--bg-black); border: 1px solid var(--border-gray); padding: 10px 15px 10px 35px; color: var(--text-white); border-radius: 4px; }
        .search-box-input i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-gray); }
        .filter-list li { margin-bottom: 8px; }
        .filter-list a { color: var(--text-gray); font-size: 0.9rem; transition: var(--transition); display: block; padding: 5px 0; cursor: pointer; }
        .filter-list a:hover, .filter-list a.active { color: var(--primary-red); padding-left: 5px; }
        .price-slider-group input[type="range"] { width: 100%; accent-color: var(--primary-red); margin-bottom: 10px; }
        .price-output { font-size: 0.9rem; color: var(--text-gray); }
        .size-tags { display: flex; flex-wrap: wrap; gap: 8px; }
        .size-tag { background: var(--bg-black); border: 1px solid var(--border-gray); color: var(--text-white); padding: 6px 12px; font-size: 0.85rem; border-radius: 4px; cursor: pointer; transition: var(--transition); }
        .size-tag:hover, .size-tag.active { background: var(--primary-red); border-color: var(--primary-red); }
        .shop-topbar { display: flex; justify-content: space-between; align-items: center; background: var(--card-black); border: 1px solid var(--border-gray); padding: 15px 20px; border-radius: 8px; margin-bottom: 25px; }
        .shop-topbar p { color: var(--text-gray); font-size: 0.9rem; }
        .sort-select { background: var(--bg-black); color: var(--text-white); border: 1px solid var(--border-gray); padding: 8px 15px; border-radius: 4px; font-size: 0.9rem; }

        /* Cart & Checkout Layout */
        .cart-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 30px; }
        .cart-table-box, .cart-summary-card, .checkout-form, .order-summary-box { background: var(--card-black); border: 1px solid var(--border-gray); border-radius: 8px; padding: 25px; }
        .cart-table { width: 100%; border-collapse: collapse; }
        .cart-table th, .cart-table td { padding: 15px; text-align: left; border-bottom: 1px solid var(--border-gray); }
        .cart-table th { font-family: var(--font-heading); font-size: 0.9rem; color: var(--text-gray); }
        .cart-product-cell { display: flex; align-items: center; gap: 15px; }
        .cart-product-cell img { width: 60px; height: 70px; object-fit: cover; border-radius: 4px; }
        .cart-prod-info h4 { font-size: 0.95rem; margin-bottom: 3px; }
        .cart-prod-info p { font-size: 0.8rem; color: var(--text-gray); }
        .qty-controls { display: flex; align-items: center; border: 1px solid var(--border-gray); width: fit-content; border-radius: 4px; }
        .qty-btn { background: var(--bg-black); color: var(--text-white); border: none; width: 28px; height: 28px; cursor: pointer; font-weight: bold; }
        .qty-input { width: 35px; text-align: center; background: transparent; border: none; color: var(--text-white); font-size: 0.9rem; }
        .remove-cart-item { background: transparent; border: none; color: var(--primary-red); font-size: 1.1rem; cursor: pointer; }
        .summary-line { display: flex; justify-content: space-between; margin-bottom: 15px; color: var(--text-gray); font-size: 0.95rem; }
        .total-line { border-top: 1px solid var(--border-gray); padding-top: 15px; font-weight: 700; color: var(--text-white); font-size: 1.1rem; }
        .text-red { color: var(--primary-red); }

        .checkout-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 30px; }
        .form-group { margin-bottom: 20px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .form-group label { display: block; font-size: 0.85rem; margin-bottom: 8px; color: var(--text-gray); }
        .form-group input, .form-group select, .form-group textarea { width: 100%; background: var(--bg-black); border: 1px solid var(--border-gray); padding: 12px 15px; color: var(--text-white); border-radius: 4px; }
        .payment-options { display: flex; flex-direction: column; gap: 12px; margin-top: 15px; }
        .pay-card { display: flex; align-items: center; gap: 15px; background: var(--bg-black); border: 1px solid var(--border-gray); padding: 15px; border-radius: 6px; cursor: pointer; }
        .pay-option input:checked + .pay-card { border-color: var(--primary-red); background: rgba(230, 0, 0, 0.05); }

        /* Admin Styles */
        .admin-wrapper { display: flex; min-height: 80vh; }
        .admin-sidebar { width: 260px; background-color: var(--card-black); border-right: 1px solid var(--border-gray); padding: 30px 20px; }
        .admin-nav li { margin-bottom: 10px; }
        .admin-nav a { display: flex; align-items: center; gap: 12px; padding: 12px 15px; color: var(--text-gray); font-weight: 500; border-radius: 6px; cursor: pointer; }
        .admin-nav a:hover, .admin-nav a.active { background-color: var(--primary-red); color: var(--text-white); }
        .admin-main { flex: 1; padding: 30px 40px; }
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 40px; }
        .stat-card { background: var(--card-black); border: 1px solid var(--border-gray); padding: 25px; border-radius: 8px; display: flex; align-items: center; gap: 20px; }
        .stat-card i { font-size: 2.5rem; color: var(--primary-red); }
        .admin-table { width: 100%; border-collapse: collapse; background: var(--card-black); border: 1px solid var(--border-gray); border-radius: 8px; }
        .admin-table th, .admin-table td { padding: 15px 20px; text-align: left; border-bottom: 1px solid var(--border-gray); font-size: 0.9rem; }
        .admin-table img { width: 45px; height: 50px; object-fit: cover; border-radius: 4px; }
        .status-badge { padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; }
        .status-processing { background: rgba(23, 162, 184, 0.15); color: #17a2b8; }
        .status-completed { background: rgba(40, 167, 69, 0.15); color: #28a745; }

        /* Footer */
        .footer { background-color: #050505; border-top: 1px solid var(--border-gray); padding: 70px 0 20px 0; margin-top: 50px; }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 40px; margin-bottom: 50px; }
        .footer-col h3 { font-family: var(--font-heading); font-size: 1.1rem; margin-bottom: 20px; }
        .footer-col ul li { margin-bottom: 10px; }
        .footer-col ul li a { color: var(--text-gray); font-size: 0.9rem; cursor: pointer; }
        .footer-bottom { text-align: center; border-top: 1px solid var(--border-gray); padding-top: 20px; color: var(--text-gray); font-size: 0.85rem; }

        /* Modals & Helpers */
        .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 2000; align-items: center; justify-content: center; padding: 20px; }
        .modal-content { background: var(--card-black); border: 1px solid var(--border-gray); width: 100%; max-width: 600px; padding: 35px; border-radius: 8px; position: relative; }
        .close-modal { position: absolute; top: 15px; right: 20px; font-size: 1.8rem; color: var(--text-gray); cursor: pointer; }
        .whatsapp-float { position: fixed; bottom: 30px; right: 30px; background-color: #25d366; color: #fff; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4); z-index: 999; }
        .page-view { display: none; }
        .page-view.active { display: block; }

        @media (max-width: 1024px) {
            .products-grid, .categories-grid, .features-bar { grid-template-columns: repeat(2, 1fr); }
            .footer-grid { grid-template-columns: 1fr 1fr; }
            .shop-layout, .checkout-grid, .cart-layout { grid-template-columns: 1fr; }
        }
    </style>
</head>
