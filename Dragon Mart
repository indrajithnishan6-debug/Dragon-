    <!-- Core App Script -->
    <script>
        const defaultProducts = [
            { id: "dm-01", name: "Crimson Dragon Oversized Tee", category: "Oversized", price: 4500, discountPrice: 3800, sizes: ["S", "M", "L", "XL"], image: "https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?auto=format&fit=crop&w=600&q=80", badge: "Best Seller" },
            { id: "dm-02", name: "Imperial Golden Dragon Tee", category: "Graphic", price: 3950, discountPrice: 3200, sizes: ["M", "L", "XL"], image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=600&q=80", badge: "New" },
            { id: "dm-03", name: "Shadow Warrior Black Plain Tee", category: "Plain", price: 2800, discountPrice: 2400, sizes: ["S", "M", "L"], image: "https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=600&q=80", badge: "Sale" },
            { id: "dm-04", name: "Yin Yang Couple Tees", category: "Couple", price: 6500, discountPrice: 5800, sizes: ["S", "M", "L", "XL"], image: "https://images.unsplash.com/photo-1516257984-b1b4d707412e?auto=format&fit=crop&w=600&q=80", badge: "Hot" }
        ];

        const defaultOrders = [
            { orderId: "DRG-8921", customerName: "Nishan Indrajith", mobile: "070 4753431", total: 4150, status: "Completed" }
        ];

        if (!localStorage.getItem('dragon_products')) localStorage.setItem('dragon_products', JSON.stringify(defaultProducts));
        if (!localStorage.getItem('dragon_cart')) localStorage.setItem('dragon_cart', JSON.stringify([]));
        if (!localStorage.getItem('dragon_orders')) localStorage.setItem('dragon_orders', JSON.stringify(defaultOrders));

        function getProducts() { return JSON.parse(localStorage.getItem('dragon_products')); }
        function getCart() { return JSON.parse(localStorage.getItem('dragon_cart')); }
        function setCart(c) { localStorage.setItem('dragon_cart', JSON.stringify(c)); updateCartBadge(); }
        function getOrders() { return JSON.parse(localStorage.getItem('dragon_orders')); }
        function formatLKR(val) { return 'Rs. ' + Number(val).toLocaleString('en-LK'); }

        function updateCartBadge() {
            const cart = getCart();
            const total = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cartCount').textContent = total;
        }

        function switchPage(pageId) {
            document.querySelectorAll('.page-view').forEach(p => p.classList.remove('active'));
            document.getElementById('page-' + pageId).classList.add('active');
            window.scrollTo(0, 0);

            if (pageId === 'home') renderHomeProducts();
            if (pageId === 'shop') renderShopProducts('All');
            if (pageId === 'cart') renderCartPage();
            if (pageId === 'checkout') renderCheckoutSummary();
            if (pageId === 'admin') renderAdminDashboard();
        }

        function switchCategoryFilter(cat) {
            switchPage('shop');
            setCatFilter(cat);
        }

        function renderHomeProducts() {
            const products = getProducts();
            const container = document.getElementById('featuredProductsContainer');
            container.innerHTML = products.slice(0, 4).map(p => productCardHTML(p)).join('');
        }

        function productCardHTML(p) {
            return `
                <div class="product-card">
                    <div class="product-img-box">
                        ${p.badge ? `<span class="product-badge">${p.badge}</span>` : ''}
                        <img src="${p.image}" alt="${p.name}">
                    </div>
                    <div class="product-details">
                        <span class="product-category">${p.category}</span>
                        <h3 class="product-title">${p.name}</h3>
                        <div class="product-prices">
                            <span class="current-price">${formatLKR(p.discountPrice || p.price)}</span>
                            ${p.discountPrice ? `<span class="old-price">${formatLKR(p.price)}</span>` : ''}
                        </div>
                        <div class="product-actions">
                            <button class="btn-cart" onclick="addToCart('${p.id}')">Add Cart</button>
                            <button class="btn-buy" onclick="buyNow('${p.id}')">Buy Now</button>
                        </div>
                    </div>
                </div>
            `;
        }

        let currentCat = 'All';
        function setCatFilter(cat) {
            currentCat = cat;
            document.querySelectorAll('.filter-list a').forEach(a => a.classList.remove('active'));
            const el = document.getElementById('cat-' + cat);
            if (el) el.classList.add('active');
            renderShopProducts(cat);
        }

        function renderShopProducts(cat) {
            let products = getProducts();
            if (cat && cat !== 'All') {
                products = products.filter(p => p.category.toLowerCase() === cat.toLowerCase());
            }
            const search = document.getElementById('searchInput').value.toLowerCase();
            if (search) {
                products = products.filter(p => p.name.toLowerCase().includes(search));
            }
            document.getElementById('productCountDisplay').textContent = `Showing ${products.length} products`;
            document.getElementById('shopProductsContainer').innerHTML = products.map(p => productCardHTML(p)).join('') || '<p style="color:var(--text-gray);">No products found.</p>';
        }

        function filterProducts() {
            renderShopProducts(currentCat);
        }

        function addToCart(id) {
            const products = getProducts();
            const p = products.find(x => x.id === id);
            if (!p) return;
            let cart = getCart();
            const idx = cart.findIndex(x => x.id === id);
            if (idx > -1) { cart[idx].qty += 1; } 
            else { cart.push({ id: p.id, name: p.name, price: p.discountPrice || p.price, image: p.image, size: 'L', qty: 1 }); }
            setCart(cart);
            alert(`"${p.name}" added to cart!`);
        }

        function buyNow(id) {
            addToCart(id);
            switchPage('cart');
        }

        function renderCartPage() {
            const cart = getCart();
            const container = document.getElementById('cartLayoutContainer');
            if (cart.length === 0) {
                container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 40px;"><h3 style="margin-bottom:15px;">Your Cart is Empty</h3><button class="btn btn-primary" onclick="switchPage('shop')">Shop Now</button></div>`;
                return;
            }
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            container.innerHTML = `
                <div class="cart-table-box">
                    <table class="cart-table">
                        <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr></thead>
                        <tbody>
                            ${cart.map((item, idx) => `
                                <tr>
                                    <td><div class="cart-product-cell"><img src="${item.image}"><div><h4>${item.name}</h4><p>Size: ${item.size}</p></div></div></td>
                                    <td>${formatLKR(item.price)}</td>
                                    <td>
                                        <div class="qty-controls">
                                            <button class="qty-btn" onclick="updateQty(${idx}, -1)">-</button>
                                            <input type="text" class="qty-input" value="${item.qty}" readonly>
                                            <button class="qty-btn" onclick="updateQty(${idx}, 1)">+</button>
                                        </div>
                                    </td>
                                    <td><strong>${formatLKR(item.price * item.qty)}</strong></td>
                                    <td><button class="remove-cart-item" onclick="removeItem(${idx})"><i class="fa-solid fa-xmark"></i></button></td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
                <div class="cart-summary-card">
                    <h3>Cart Totals</h3>
                    <div class="summary-line"><span>Subtotal</span><span>${formatLKR(subtotal)}</span></div>
                    <div class="summary-line"><span>Delivery</span><span>Rs. 350</span></div>
                    <div class="summary-line total-line"><span>Total</span><span class="text-red">${formatLKR(subtotal + 350)}</span></div>
                    <button class="btn btn-primary btn-block" style="margin-top:20px;" onclick="switchPage('checkout')">Proceed to Checkout</button>
                </div>
            `;
        }

        function updateQty(idx, val) {
            let cart = getCart();
            cart[idx].qty += val;
            if (cart[idx].qty <= 0) cart.splice(idx, 1);
            setCart(cart);
            renderCartPage();
        }

        function removeItem(idx) {
            let cart = getCart();
            cart.splice(idx, 1);
            setCart(cart);
            renderCartPage();
        }

        let discountRate = 0;
        function applyCoupon() {
            const code = document.getElementById('couponInput').value.trim().toUpperCase();
            const fb = document.getElementById('couponFeedback');
            if (code === 'DRAGON30') {
                discountRate = 0.30;
                fb.textContent = "Coupon applied! (30% OFF)"; fb.style.color = "#28a745";
            } else {
                discountRate = 0;
                fb.textContent = "Invalid code."; fb.style.color = "var(--primary-red)";
            }
            renderCheckoutSummary();
        }

        function renderCheckoutSummary() {
            const cart = getCart();
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const disc = subtotal * discountRate;
            document.getElementById('checkoutItemsList').innerHTML = cart.map(i => `<div style="display:flex; justify-content:space-between; margin-bottom:8px;"><span>${i.name} x ${i.qty}</span><strong>${formatLKR(i.price * i.qty)}</strong></div>`).join('');
            document.getElementById('summarySubtotal').textContent = formatLKR(subtotal);
            document.getElementById('summaryDiscount').textContent = `- ${formatLKR(disc)}`;
            document.getElementById('summaryTotal').textContent = formatLKR(subtotal - disc + 350);
        }

        function handleCheckout(e) {
            e.preventDefault();
            const cart = getCart();
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const total = subtotal - (subtotal * discountRate) + 350;
            const newOrder = {
                orderId: 'DRG-' + Math.floor(1000 + Math.random() * 9000),
                customerName: document.getElementById('custName').value,
                mobile: document.getElementById('custMobile').value,
                total,
                status: 'Processing'
            };
            let orders = getOrders();
            orders.unshift(newOrder);
            localStorage.setItem('dragon_orders', JSON.stringify(orders));
            localStorage.setItem('dragon_cart', JSON.stringify([]));
            updateCartBadge();

            document.getElementById('successModalText').textContent = `Order ID: ${newOrder.orderId} | Total: ${formatLKR(newOrder.total)}`;
            const waText = encodeURIComponent(`Hello Dragon Mart, my Order ID is ${newOrder.orderId} and total is ${formatLKR(newOrder.total)}`);
            document.getElementById('whatsappConfirmBtn').href = `https://wa.me/94704753431?text=${waText}`;
            document.getElementById('successModal').style.display = 'flex';
        }

        function switchAdminTab(tab) {
            document.querySelectorAll('.adm-tab-pane').forEach(p => p.style.display = 'none');
            document.querySelectorAll('.admin-nav a').forEach(a => a.classList.remove('active'));
            document.getElementById('adm-content-' + tab).style.display = 'block';
            document.getElementById('adm-tab-' + tab.substring(0,4)).classList.add('active');
            if (tab === 'products') renderAdminProducts();
            if (tab === 'orders') renderAdminOrders();
        }

        function renderAdminDashboard() {
            document.getElementById('statProducts').textContent = getProducts().length;
            const orders = getOrders();
            document.getElementById('statOrders').textContent = orders.length;
            const rev = orders.reduce((s, o) => s + o.total, 0);
            document.getElementById('statSales').textContent = formatLKR(rev);
            switchAdminTab('dashboard');
        }

        function renderAdminProducts() {
            const products = getProducts();
            document.querySelector('#adminProductsTable tbody').innerHTML = products.map(p => `
                <tr><td><img src="${p.image}"></td><td>${p.name}</td><td>${p.category}</td><td>${formatLKR(p.discountPrice || p.price)}</td><td><button class="btn" style="background:var(--primary-red); color:#fff; padding:4px 8px; font-size:0.8rem;" onclick="deleteProduct('${p.id}')">Delete</button></td></tr>
            `).join('');
        }

        function deleteProduct(id) {
            let products = getProducts().filter(p => p.id !== id);
            localStorage.setItem('dragon_products', JSON.stringify(products));
            renderAdminProducts();
        }

        function openAddProductModal() {
            document.getElementById('productModal').style.display = 'flex';
        }

        function handleSaveProduct(e) {
            e.preventDefault();
            let products = getProducts();
            products.unshift({
                id: 'dm-' + Date.now(),
                name: document.getElementById('admName').value,
                category: document.getElementById('admCat').value,
                price: Number(document.getElementById('admPrice').value),
                image: document.getElementById('admImg').value,
                badge: "New"
            });
            localStorage.setItem('dragon_products', JSON.stringify(products));
            document.getElementById('productModal').style.display = 'none';
            renderAdminProducts();
            alert("Product added successfully!");
        }

        function renderAdminOrders() {
            const orders = getOrders();
            document.querySelector('#adminOrdersTable tbody').innerHTML = orders.map(o => `
                <tr><td>${o.orderId}</td><td>${o.customerName}</td><td>${o.mobile}</td><td>${formatLKR(o.total)}</td><td><span class="status-badge status-processing">${o.status}</span></td></tr>
            `).join('');
        }

        // Initial Load
        updateCartBadge();
        renderHomeProducts();
    </script>
</body>
</html>
